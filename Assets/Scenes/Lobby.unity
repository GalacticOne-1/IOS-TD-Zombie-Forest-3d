MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1948781758}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf9a17b86c994c9f85b7d9b88d4d6103, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  prefab: {fileID: 2428504096918887418, guid: 47d38f516720c47e1a0dcf5a9514a348, type: 3}
  dialog:
  - text: Hello, survivor! I'm Frankie, my camp is in the west, near the army radar
      station...
    textButton: Hi!
  - text: I saw you on the radar and wanted to see the new neighbor...
    textButton: Ok
  - text: Not a bad camp, but I would put a couple more strong walls! These will
      protect against regular zombies, but there are more terrible creatures in this
      place...
    textButton: I'll take note
  - text: Several of these creatures recently attacked a military convoy a few miles
      from here...
    textButton: Damn ...
  - text: I'm going there, maybe there's some equipment left there, you know, after
      all, it's the army, damn them, there should be some worthwhile things there...
    textButton: Aha
  - text: "If you want, \nI can give you a ride!"
    textButton: Sure!
